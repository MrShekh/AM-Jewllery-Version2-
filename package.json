{
  "name": "am-jewellers-erp-v2",
  "version": "2.0.0-pilot.1",
  "private": true,
  "description": "AM Jewellers Gold Manufacturing & Order ERP - Version 2 (Increment 1 Pilot)",
  "scripts": {
    "dev": "next dev -p 3001",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio -p 5556"
  },
  "dependencies": {
    "@prisma/client": "6.5.0",
    "@tanstack/react-table": "8.21.2",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bcryptjs": "2.4.3",
    "decimal.js": "10.5.0",
    "exceljs": "4.4.0",
    "html2canvas": "^1.4.1",
    "jose": "5.9.6",
    "jspdf": "2.5.2",
    "lucide-react": "0.475.0",
    "next": "15.3.2",
    "pino": "^10.4.0",
    "qrcode": "1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.9",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "^22.13.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "prisma": "6.5.0",
    "tailwindcss": "^4.0.9",
    "tsx": "4.19.3",
    "typescript": "^5.8.2",
    "vitest": "3.0.7"
  }
}
