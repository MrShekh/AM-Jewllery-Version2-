# ============================================================================
# AM Jewellers ERP V2 (Increment 1 Pilot) - Environment Configuration Example
# Copy this file to .env and adjust values for your local environment.
# ============================================================================

# PostgreSQL Database Connection (Docker Compose default exposes port 5433 on host)
DATABASE_URL="postgresql://am_v2_user:am_v2_dev_password_change_me@localhost:5433/am_jewellers_v2_dev?schema=public"

# Canonical Base URL used for QR code generation and deep links (Dev port: 3001)
APP_BASE_URL="http://localhost:3001"
NEXT_PUBLIC_APP_BASE_URL="http://localhost:3001"

# Authentication & Session Configuration
# Generate a strong secret in production: openssl rand -base64 32
AUTH_SESSION_SECRET="replace-with-at-least-32-char-random-secret-key-for-v2"
SESSION_COOKIE_NAME="am_v2_session"
SESSION_TTL_HOURS="24"

# Explicit Development Seed Credentials (used ONLY by `npm run db:seed`)
SEED_ORG_CODE="AM-JEWELLERS"
SEED_ORG_NAME="AM Jewellers"
SEED_ADMIN_EMAIL="admin@amjewellers.local"
SEED_ADMIN_PASSWORD="ChangeMeAdmin!2026"
SEED_OPERATOR_EMAIL="operator@amjewellers.local"
SEED_OPERATOR_PASSWORD="ChangeMeOperator!2026"

# Timezone for business date and monthly sheet boundaries
APP_TIMEZONE="Asia/Kolkata"

# Local Persistent Upload Storage Directory (relative to ./version2 or absolute path)
UPLOAD_STORAGE_DIR="./storage/uploads"

# Optional Cloudinary Configuration (leave empty to use persistent local storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

