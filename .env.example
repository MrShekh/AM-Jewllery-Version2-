# ============================================================================
# AM Jewellers ERP V2 - Environment Configuration Example (Local & Production)
# Copy this file to .env and fill in your values.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. PostgreSQL / Neon Database Connection
# ----------------------------------------------------------------------------
# For Neon PostgreSQL (Recommended for Production):
# - DATABASE_URL: Pooled connection string (ends with -pooler...&sslmode=require)
# - DIRECT_URL:   Direct (non-pooled) connection string for Prisma migrations
#
# Neon Example:
# DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# DIRECT_URL="postgresql://neondb_owner:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
#
# Local Docker Compose Default (port 5433):
DATABASE_URL="postgresql://am_v2_user:am_v2_dev_password_change_me@localhost:5433/am_jewellers_v2_dev?schema=public"
DIRECT_URL="postgresql://am_v2_user:am_v2_dev_password_change_me@localhost:5433/am_jewellers_v2_dev?schema=public"

# ----------------------------------------------------------------------------
# 2. Canonical App URL (Used for QR codes, PDF share links, and HTTPS cookies)
# ----------------------------------------------------------------------------
APP_BASE_URL="http://localhost:3001"
NEXT_PUBLIC_APP_BASE_URL="http://localhost:3001"

# ----------------------------------------------------------------------------
# 3. Authentication & Session Security
# ----------------------------------------------------------------------------
# Generate a strong random secret for production: openssl rand -base64 32
AUTH_SESSION_SECRET="replace-with-at-least-32-char-random-secret-key-for-v2"
SESSION_COOKIE_NAME="am_v2_session"
SESSION_TTL_HOURS="24"
# Optional: force "true" (HTTPS only) or "false" (allow HTTP on local LAN). Leave empty for auto-detect.
COOKIE_SECURE=""

# ----------------------------------------------------------------------------
# 4. Seed Credentials (used ONLY by `npm run db:seed`)
# ----------------------------------------------------------------------------
SEED_ORG_CODE="AM-JEWELLERS"
SEED_ORG_NAME="AM Jewellers"
SEED_ADMIN_EMAIL="admin@amjewellers.local"
SEED_ADMIN_PASSWORD="ChangeMeAdmin!2026"
SEED_OPERATOR_EMAIL="operator@amjewellers.local"
SEED_OPERATOR_PASSWORD="ChangeMeOperator!2026"

# ----------------------------------------------------------------------------
# 5. Business Timezone & Storage
# ----------------------------------------------------------------------------
APP_TIMEZONE="Asia/Kolkata"
UPLOAD_STORAGE_DIR="./storage/uploads"
WHATSAPP_AUTH_DIR="./storage/whatsapp-auth"

# Optional Cloudinary Configuration (recommended in serverless production if local disk is ephemeral)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
