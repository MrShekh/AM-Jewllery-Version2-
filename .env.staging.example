# Staging Environment Example (.env.staging)
# Copy to .env.staging (or .env.local in an isolated staging workspace) and fill in your Neon staging branch URL.
# NEVER put production DATABASE_URL, production AUTH_SESSION_SECRET, or production Cloudinary keys here.

APP_ENV="staging"
NEXT_PUBLIC_APP_ENV="staging"
ALLOW_STAGING_MUTATIONS="true"
STAGING_DB_IDENTITY="customer-cad-staging"

# Separate Neon schema-only branch: customer-cad-staging
DATABASE_URL="postgresql://USER:PASSWORD@EP-STAGING-POOLER.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@EP-STAGING-DIRECT.REGION.aws.neon.tech/neondb?sslmode=require"

# Staging app URL & auth isolation
APP_BASE_URL="http://localhost:3001"
NEXT_PUBLIC_APP_BASE_URL="http://localhost:3001"
AUTH_SESSION_SECRET="staging-only-secret-change-this-32-chars-minimum"
SESSION_COOKIE_NAME="am_v2_staging_session"
SESSION_TTL_HOURS="24"
COOKIE_SECURE="false"

# Isolated staging storage & disabled external notifications
UPLOAD_STORAGE_DIR="./storage/staging-uploads"
DISABLE_EXTERNAL_NOTIFICATIONS="true"

# Feature flags (set any to "false" to disable without rolling back DB)
FEATURE_CUSTOMER_APP="true"
FEATURE_CAD_DASHBOARD="true"
FEATURE_APP_ORDERS="true"
FEATURE_CATALOGUE="true"
