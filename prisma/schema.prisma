enum StockSaleStatus {
  POSTED
  REVERSED
}

enum StockSalePaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum StockConversionType {
  FINE_TO_KARAT
  KARAT_TO_FINE
  REFINING
  ALLOYING
}

enum RefiningLossTreatment {
  NONE
  OUTSTANDING
  ACCEPTED
}

model StockSale {
  id                   String                 @id @default(cuid())
  organizationId       String
  organization         Organization           @relation(fields: [organizationId], references: [id])
  saleNumber           String
  businessDate         DateTime
  purityId             String
  purity               PurityDefinition       @relation(fields: [purityId], references: [id])
  physicalWeight       Decimal                @db.Decimal(18, 6)
  touchPercentSnapshot Decimal                @db.Decimal(8, 4)
  fineEquivalentWeight Decimal                @db.Decimal(18, 6)
  buyerName            String
  buyerPhone           String?
  pricePerGramRupees   Decimal                @default(0) @db.Decimal(18, 2)
  totalAmountRupees    Decimal                @default(0) @db.Decimal(18, 2)
  paidAmountRupees     Decimal                @default(0) @db.Decimal(18, 2)
  paymentStatus        StockSalePaymentStatus @default(UNPAID)
  status               StockSaleStatus        @default(POSTED)
  referenceNumber      String?
  notes                String?
  journalTransactionId String?
  idempotencyKey       String                 @unique
  createdById          String
  createdAt            DateTime               @default(now())
  reversedAt           DateTime?
  reversedById         String?
  reversalReason       String?

  @@unique([organizationId, saleNumber])
  @@index([organizationId, businessDate])
}

model StockConversion {
  id                     String                @id @default(cuid())
  organizationId         String
  organization           Organization          @relation(fields: [organizationId], references: [id])
  conversionNumber       String
  conversionType         StockConversionType
  businessDate           DateTime
  sourcePurityId         String
  sourcePurity           PurityDefinition      @relation("ConversionSourcePurity", fields: [sourcePurityId], references: [id])
  sourceWeight           Decimal               @db.Decimal(18, 6)
  sourceTouchPercent     Decimal               @db.Decimal(8, 4)
  theoreticalFineWeight  Decimal               @db.Decimal(18, 6)
  targetPurityId         String
  targetPurity           PurityDefinition      @relation("ConversionTargetPurity", fields: [targetPurityId], references: [id])
  actualOutputWeight     Decimal               @db.Decimal(18, 6)
  actualOutputTouch      Decimal               @db.Decimal(8, 4)
  actualOutputFineWeight Decimal               @db.Decimal(18, 6)
  residueWeight          Decimal               @default(0) @db.Decimal(18, 6)
  returnedMetalWeight    Decimal               @default(0) @db.Decimal(18, 6)
  lossFineWeight         Decimal               @default(0) @db.Decimal(18, 6)
  lossTreatment          RefiningLossTreatment @default(NONE)
  refinerOrPartner       String?
  notes                  String?
  journalTransactionId   String?
  idempotencyKey         String                @unique
  createdById            String
  createdAt              DateTime              @default(now())

  @@unique([organizationId, conversionNumber])
  @@index([organizationId, businessDate])
}

model BillShareToken {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  billId          String
  bill            CustomerBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  token           String       @unique
  isRevoked       Boolean      @default(false)
  expiresAt       DateTime?
  createdByUserId String
  createdAt       DateTime     @default(now())
  revokedAt       DateTime?

  @@index([organizationId, billId])
}


