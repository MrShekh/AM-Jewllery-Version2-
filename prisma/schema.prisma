  businessDate         DateTime
  reason               String
  status               LossWriteOffStatus @default(ACTIVE)
  idempotencyKey       String             @unique
  createdById          String
  createdAt            DateTime           @default(now())
  reversedAt           DateTime?
  reversalReason       String?
