  @@index([organizationId, processLossRecordId, status])
  @@index([organizationId, karigarId, status])
}

model RecoverySettlement {
  id                    String       @id @default(cuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id])
  karigarId             String
  karigar               Karigar      @relation(fields: [karigarId], references: [id])
  settlementNumber      String
  businessDate          DateTime
  scopeType             String // SINGLE_TOUCH | ALL_TOUCHES
  scopeTouchPercent     Decimal?     @db.Decimal(8, 4)
  scopeProcessType      ProcessType?
  grossSelectedFine     Decimal      @db.Decimal(18, 6)
  makingDeductionFine   Decimal      @db.Decimal(18, 6)
  makingInputWeight     Decimal      @db.Decimal(18, 6)
  makingInputUnit       String // RAW_AT_TOUCH | FINE
  netExpectedFine       Decimal      @db.Decimal(18, 6)
  receivedFine          Decimal      @db.Decimal(18, 6)
  differenceFine        Decimal      @db.Decimal(18, 6)
  shortageAction        String? // CARRY_FORWARD | ACCEPT_AND_CLEAR | ACCEPT_PART | NONE | EXCESS
  acceptedShortageFine  Decimal      @default(0) @db.Decimal(18, 6)
  carriedShortageFine   Decimal      @default(0) @db.Decimal(18, 6)
  excessFine            Decimal      @default(0) @db.Decimal(18, 6)
